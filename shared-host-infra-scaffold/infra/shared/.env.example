POSTGRES_SUPERUSER=admin
# Change before the first `docker compose up`. Also set the per-project
# application role password (hexa_app) via the project's own
# scripts/migrate_db.sh — it must NOT be committed anywhere.
POSTGRES_SUPERUSER_PASSWORD=change_me_before_first_up

# Optional: pre-provisions the hexa_app role password on first boot
# (see postgres/init/02_set_app_password.sh). If left empty, the app
# role has no password until scripts/migrate_db.sh is run against the
# live database. Keep it in sync with HEXA_DATABASE_URL in backend/.env.
POSTGRES_APP_PASSWORD=